# The database. Everything else is optional until you want messages delivered.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/agnext"

# --- Sending text messages (Twilio) -----------------------------------------
# Without all three, nothing is delivered: sign-in codes queue in the
# `notifications` table and the drain reports "no delivery provider
# configured". That is deliberate — a half-configured system must not look
# like it is working.
#
# From the Twilio console:
#   TWILIO_ACCOUNT_SID   starts AC…, on the dashboard
#   TWILIO_AUTH_TOKEN    on the dashboard; rotate it if it ever leaks
#   TWILIO_FROM          a Twilio number in E.164 (+15551234567), or a
#                        Messaging Service SID (MG + 32 hex characters)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Before any of this reaches a driver, four things have to be true in the
# Twilio console. Each one fails in a way that looks like a bug in this code,
# so check them first:
#
#   1. A2P 10DLC registration. In the US, texts from a normal 10-digit number
#      to ordinary phones must be registered to a brand and a campaign, and it
#      takes days, not minutes. Unregistered traffic is rejected outright
#      (30034) or filtered by the carrier with no error at all. This is the
#      single most likely reason a correctly configured system sends nothing.
#   2. A trial account can only text numbers you have verified in the console,
#      and prefixes every message with a trial notice. A driver's sign-in code
#      arrives with a paragraph in front of it, or does not arrive.
#   3. The `TWILIO_FROM` number has to be SMS-capable. Some Twilio numbers are
#      voice only; sending from one fails with 21606 every time. And a
#      toll-free number (+1 8xx) additionally needs Toll-Free Verification
#      before US carriers will pass anything from it — until then every
#      message is accepted by Twilio and refused by the carrier (30032). This
#      is what happened to the first real message this system sent.
#   4. Geographic permissions. Texting a country is off until it is switched
#      on for the account — including Canada for a US account. This is 21408,
#      and it is a checkbox, not a fault in the number.
#
# The startup line and the drain's `provider` field say what is *configured*.
# They cannot say any of the four above are right — only a real message to a
# real handset shows that.

# The region a roster number written without a country code belongs to. A
# two-letter country (US, GB, CA), never a dialling prefix: "+1 on any ten
# digits" turned a London number into a real one in Maine and sent a driver's
# sign-in code to a stranger.
SMS_DEFAULT_REGION="US"

# Where Twilio posts delivery reports. Until this is set, a message stops at
# `accepted` — Twilio has it, and nobody knows whether the driver does. That
# is exactly the blindness docs/06-external-services.md gives as the reason
# for leaving the carrier email gateways, so set it in production.
# Must be the public https URL of this deployment, because it is also the
# string Twilio's request signature is checked against.
TWILIO_STATUS_CALLBACK_URL=""

# Where the Twilio API lives. Leave unset for api.twilio.com. Regional
# endpoints (api.au1.twilio.com, api.ie1.twilio.com) are for data residency.
# Must be https unless it is a stand-in on this machine: every request carries
# the auth token and every message carries a sign-in code.
# TWILIO_BASE_URL="https://api.twilio.com"

# --- The outbox drain -------------------------------------------------------
# The job endpoint refuses to run without this rather than defaulting open.
# Point a scheduler at POST /api/jobs/drain-outbox with this as a bearer token.
CRON_SECRET=""

# How long a worker's claim on a message is honoured before a sweeper may take
# it back. Rarely needs changing. A plain number of seconds, at least 10 —
# "2m" is refused at startup rather than becoming NaN, which silently defeated
# the check that a send can never outlast a claim and then took every drain
# down at the first query.
# OUTBOX_LEASE_SECONDS="120"
