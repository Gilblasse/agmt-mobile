# The database. Everything else is optional until you want messages delivered.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/agnext"

# --- Sending text messages (Twilio) -----------------------------------------
# Without all three, nothing is delivered: sign-in codes queue in the
# `notifications` table and the drain reports "no delivery provider
# configured". That is deliberate — a half-configured system must not look
# like it is working.
#
# From the Twilio console:
#   TWILIO_ACCOUNT_SID   starts AC…, on the dashboard
#   TWILIO_AUTH_TOKEN    on the dashboard; rotate it if it ever leaks
#   TWILIO_FROM          a Twilio number in E.164 (+15551234567), or a
#                        Messaging Service SID (MG…) if you have one
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Country code assumed for a roster number stored without one (845… → +1845…).
SMS_DEFAULT_COUNTRY_CODE="1"

# --- The outbox drain -------------------------------------------------------
# The job endpoint refuses to run without this rather than defaulting open.
# Point a scheduler at POST /api/jobs/drain-outbox with this as a bearer token.
CRON_SECRET=""
